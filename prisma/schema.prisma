generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  bookmarks Bookmark[]
  createdAt DateTime   @default(now())
}

model Bookmark {
  id        String   @id @default(cuid())
  title     String
  url       String
  tags      String?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
}
